{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://story-animator.local/factory/director/schemas/breakdown.schema.json",
 "title": "breakdown.json (stage 2 Breakdown)",
 "description": "Locations, sets, characters, props, FX, vehicles, time of day and weather per scene; every element is tagged with what it must DO on screen. Every narration line maps to a scene (a picture).",
 "type": "object",
 "additionalProperties": false,
 "required": ["id", "scenes", "elements"],
 "properties": {
  "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$"},
  "scenes": {
   "type": "array", "minItems": 1,
   "items": {
    "type": "object", "additionalProperties": false,
    "required": ["id", "title", "location", "time_of_day", "weather", "line_ids", "picture", "elements"],
    "properties": {
     "id": {"type": "string", "pattern": "^S[0-9]{2,3}$"},
     "title": {"type": "string"},
     "location": {"type": "string", "description": "elements[].id of kind 'location' or 'set'"},
     "time_of_day": {"enum": ["night", "dawn", "day", "dusk"]},
     "weather": {"enum": ["clear", "overcast", "storm", "rain", "fog"]},
     "line_ids": {"type": "array", "items": {"type": "string"}, "minItems": 1},
     "picture": {"type": "string", "minLength": 1, "description": "What the viewer sees while these lines play."},
     "elements": {"type": "array", "items": {"type": "string"}},
     "chapter": {"type": "string"}
    }
   }
  },
  "elements": {
   "type": "array", "minItems": 1,
   "items": {
    "type": "object", "additionalProperties": false, "required": ["id", "kind", "name", "must_do", "search_terms"],
    "properties": {
     "id": {"type": "string", "pattern": "^[a-z0-9_]+$"},
     "kind": {"enum": ["location", "set", "world", "character", "prop", "vehicle", "fx", "hdri", "texture", "overlay", "system"]},
     "name": {"type": "string"},
     "must_do": {"type": "array", "items": {"type": "string"}, "minItems": 1, "description": "What it must DO on screen (verbs)."},
     "search_terms": {"type": "array", "items": {"type": "string"}, "minItems": 1,
       "description": "Library search terms, most important first; search_terms[0] is the primary noun the librarian must match."},
     "solves_climax": {"type": "boolean", "description": "PIXAR S6: must be planted on screen before 40% of runtime."},
     "story_specific": {"type": "boolean", "description": "True when no generic stock asset can stand in (e.g. a named 1981 ship)."}
    }
   }
  }
 }
}
