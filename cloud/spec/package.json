{
  "name": "@story-animator/spec-export",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Episode spec (JSON Schema) + exporter: Remotion/three.js episode code -> episode.json, code-built props -> GLB.",
  "scripts": {
    "export": "node cli.mjs --episode sentinel",
    "export:spec": "node cli.mjs --episode sentinel --no-props",
    "validate": "node validate.mjs ../../episodes/sentinel/episode.json"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "esbuild": "0.28.1",
    "three": "0.169.0"
  }
}
